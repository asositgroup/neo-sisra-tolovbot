# Create a private .env on the bot server. Do not commit .env.
BOT_TOKEN=
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzHtHKoaPQ2-pzUW2nGuOZ9W9Moo7GhDnAss_xvN89XdNbhNih0HQIWmmQVo4gyJSdMBg/exec
# Comma-separated numeric Telegram user IDs; admin tools stay disabled if empty.
PRIMARY_ADMIN_IDS=
EXTRA_ADMIN_IDS=
# Optional admin group and forum topic IDs. Empty = no notifications.
NOTIFY_CHAT_ID=
NOTIFY_REG_TOPIC=
NOTIFY_PAY_TOPIC=
# Set a new version when approved terms change; require new consent.
OFFER_VERSION=pending-2026-10-04
OFFER_DOC_PATH=
WELCOME_IMAGE_PATH=
SERVICE_PRICE=XXX
CONTACT_PHONE=XXX
CONTACT_ADMIN=
UZCARD_NUMBER=XXXX XXXX XXXX XXXX
UZCARD_HOLDER=XXX
VISA_NUMBER=XXXX XXXX XXXX XXXX
VISA_HOLDER=XXX
# Bounded concurrency: one process only; Telegram/Google limits still apply.
UPDATE_WORKERS=32
DELIVERY_WORKERS=4
TELEGRAM_MESSAGES_PER_SECOND=25
