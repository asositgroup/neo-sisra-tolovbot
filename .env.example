# Create a private .env on the bot server. Do not commit .env.
BOT_TOKEN=
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzHtHKoaPQ2-pzUW2nGuOZ9W9Moo7GhDnAss_xvN89XdNbhNih0HQIWmmQVo4gyJSdMBg/exec
# Optional phone-update Apps Script deployment; updates existing contacts by Telegram ID.
PHONE_UPDATE_SCRIPT_URL=
# Private shared secret (at least 32 characters), matching the Apps Script configuration.
PHONE_UPDATE_SECRET=
# Comma-separated numeric Telegram user IDs; admin tools stay disabled if empty.
PRIMARY_ADMIN_IDS=
EXTRA_ADMIN_IDS=
# Optional admin group and forum topic IDs. Empty = no notifications.
NOTIFY_CHAT_ID=
NOTIFY_REG_TOPIC=
NOTIFY_PAY_TOPIC=
# Set a new version when approved terms change; require new consent.
OFFER_VERSION=2026-10-05-ac2a98121e23
# Local path; production keeps the document outside immutable releases.
OFFER_DOC_PATH=./assets/neo-sisra-oferta-2026-10-05.docx
WELCOME_IMAGE_PATH=
PAYMENT_IMAGE_PATH=
# Optional merchant checkout links. Only HTTPS on the matching provider domain
# (or its subdomains) is accepted; unconfigured providers are hidden.
# Use this business's own links; never copy another merchant's payment URL.
PAYME_URL=
CLICK_URL=
PAYNET_URL=
# Optional original Paynet QR PDF. A readable PDF enables Paynet without a URL.
# Keep it outside the current release, e.g. /opt/neo-sisra-pay-bot/assets/paynet-qr.pdf.
PAYNET_QR_PATH=
# Display prices; SERVICE_PRICE is the payable webinar offer amount.
REGULAR_SERVICE_PRICE=5 000 000 soʻm
SERVICE_PRICE=4 400 000 soʻm
CONTACT_PHONE=XXX
# Manager's @username or https://t.me/username (not a channel invite).
CONTACT_ADMIN=
HUMO_NUMBER=XXXX XXXX XXXX XXXX
HUMO_HOLDER=XXX
UZCARD_NUMBER=XXXX XXXX XXXX XXXX
UZCARD_HOLDER=XXX
VISA_NUMBER=XXXX XXXX XXXX XXXX
VISA_HOLDER=XXX
# Bounded concurrency: one process only; Telegram/Google limits still apply.
UPDATE_WORKERS=100
DELIVERY_WORKERS=4
TELEGRAM_MESSAGES_PER_SECOND=28
