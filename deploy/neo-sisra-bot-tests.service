[Unit]
Description=Isolated offline checks for Neo Sisra bot deployment

[Service]
Type=oneshot
User=neo-sisra-ci-test
Group=neo-sisra-ci-test
WorkingDirectory=/var/lib/neo-sisra-ci-test/snapshot
ExecStart=/usr/local/libexec/neo-sisra-bot-tests
Environment=HOME=/nonexistent
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=180
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/opt -/srv /var/lib/neo-sisra-deploy -/run/systemd/private -/run/dbus
MemoryMax=512M
TasksMax=128
CPUQuota=100%
LimitCORE=0
